# Environment Configuration for Huluntunzao

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_PORT=3000

# Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Data Source Configuration
DATA_PROVIDER=yahoo
CACHE_ENABLED=True
CACHE_EXPIRE_DAYS=30

# DCA Calculator Configuration
DEFAULT_START_DATE=2014-01-01
DEFAULT_END_DATE=2024-01-01
DEFAULT_DAILY_INVEST=100
DEFAULT_ETF=SPY

# Supported ETFs for DCA
SUPPORTED_ETFS=SPY,VOO,IVV

# Stock List Configuration
MAX_STOCKS_PER_PAGE=20
DEFAULT_MAX_STOCKS=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Security (for production)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
SESSION_SECRET=your-secret-key-here
